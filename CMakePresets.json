{
  "version": 3,
  "configurePresets": [
    {
      "name": "x86-debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "OFF",
        "ENABLE_TSAN": "OFF"
      }
    },

    {
      "name": "x86-release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_ASAN": "OFF",
        "ENABLE_TSAN": "OFF"
      }
    },

    {
      "name": "x86-asan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/x86-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON",
        "ENABLE_TSAN": "OFF"
      }
    },

    {
      "name": "x86-tsan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/x86-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_ASAN": "OFF",
        "ENABLE_TSAN": "ON"
      }
    }
  ],


  "buildPresets": [
    {
      "name": "x86-debug",
      "configurePreset": "x86-debug"
    },
    {
      "name": "x86-release",
      "configurePreset": "x86-release"
    },
    {
      "name": "x86-asan",
      "configurePreset": "x86-asan"
    },
    {
      "name": "x86-tsan",
      "configurePreset": "x86-tsan"
    }
  ]
}
